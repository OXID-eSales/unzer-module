{% include "@osc-unzer/frontend/tpl/order/unzer_assets.html.twig" %}
{% if false %}<script>{% endif %}
{% capture assign = "unzerApplePayJS" %}

    const unzerInstance = new unzer('{{ unzerpub }}');
    const unzerApplePayInstance = unzerInstance.ApplePay();
    const form = document.getElementById('orderConfirmAgbBottom');
    const selfUrlEncoded = decodeURIComponent('{{ oViewConf.getSelfActionLink()|url_encode('raw') }}')
    const selfActionUrl = selfUrlEncoded.replace(/&amp;/g, '&')

    const applePaySubmit = document.getElementById('submitOrder');
    if (applePaySubmit) {
        applePaySubmit.addEventListener('click', function (e) {
            e.preventDefault();
            try {
                setupApplePaySession();
            } catch (error) {
                console.error("Error during Apple Pay session setup:", error.message);
            }
        });
    } else {
        console.error("Apple Pay submit button not found!");
    }

    function startApplePaySession(applePayPaymentRequest) {

        if (window.ApplePaySession && ApplePaySession.canMakePayments()) {
            const session = new ApplePaySession(6, applePayPaymentRequest);

            session.onvalidatemerchant = function (event) {
                merchantValidationCallback(session, event);
            };

            session.onpaymentauthorized = function (event) {
                applePayAuthorizedCallback(event, session);
            };

            session.oncancel = function (event) {
                onCancelCallback(event);
            };

            session.begin();
        } else {
            console.error("Apple Pay is not supported on this device or browser.");
            handleError({ message: 'This device does not support Apple Pay!', error: new Error('Apple Pay not supported') });
        }
    }

    function applePayAuthorizedCallback(event, session) {
        try {
            const paymentData = event.payment.token.paymentData;
            unzerApplePayInstance.createResource(paymentData)
                .then(function (result) {
                const hiddenInput = document.createElement('input');
                hiddenInput.type = 'hidden';
                hiddenInput.name = 'paymentData';
                hiddenInput.value = JSON.stringify(result);
                form.appendChild(hiddenInput);
                const formData = new FormData(form);
                fetch(selfActionUrl, {
                    method: 'POST',
                    mode: 'no-cors',
                    body: formData
                }).then(response => {
                    if (!response.ok) {
                        console.error("HTTP error: " + response.statusText);
                        handleError({message: response.statusText});
                        window.location.href = url + 'cl=payment&payerror=2';
                    }
                    alert("Payment successful!");
                    session.completePayment({status: window.ApplePaySession.STATUS_SUCCESS});
                    let thankyouUrl = selfActionUrl + 'cl=thankyou';
                    setTimeout(() => {
                        window.location.href = thankyouUrl;
                    }, 2000);
                    return;
                }).catch(error => {
                    console.error("Error during executeunzer operation:", error);
                    handleError({message: error.message});
                    abortPaymentSession(session);
                    window.location.href = selfActionUrl + 'cl=payment&payerror=2';
                    return;
                });
            }).catch(error => {
                console.error("Error creating Apple Pay resource:", error);
                handleError({message: error.message});
                abortPaymentSession(session);
                return;
            });
        } catch (error) {
            console.error("Unhandled exception in Apple Pay callback:", error);
            handleError({message: error.message});
            abortPaymentSession(session);
        }
    }

    function merchantValidationCallback(session, event) {

        let shopSelfUrlEscaped = '{{ oViewConf.getSelfActionLink()|raw }}';
        let formData = new FormData();
        formData.append('cl', 'unzer_applepay_callback');
        formData.append('fnc', 'validateMerchant');
        formData.append('merchantValidationUrl', event.validationURL);
        formData.append('stoken', '{{ oViewConf.getSessionChallengeToken()|raw }}');

        fetch(shopSelfUrlEscaped, {
            method: 'POST',
            mode: 'no-cors',
            body: formData
        })
            .then(response => {
            if (!response.ok) {
                throw new Error("HTTP error: " + response.statusText);
            }

            return response.json();
        })
            .then(function (data) {
            if (data.validationResponse && data.validationResponse.merchantSessionIdentifier) {
                session.completeMerchantValidation(data.validationResponse);
            } else {
                throw new Error("Invalid validation response: Missing required fields (merchantSessionIdentifier).");
            }
        })
            .catch(function (error) {
            console.error("Error during merchant validation:", error);
            handleError({ message: error.message, error });
            session.abort();
        });
    }

    function onCancelCallback(event) {
        console.warn("Apple Pay session canceled by user. Event:", event);
        handleError({ message: 'Payment process canceled by user.' });
    }

    {% set currency = oView.getActCurrency() %}
    {% set total = oxcmp_basket.getPrice() %}
    {% set deliveryCost = oxcmp_basket.getDeliveryCost() %}

    function setupApplePaySession() {
        const applePayPaymentRequest = {
            countryCode: '{{ oView.getUserCountryIso() }}',
            currencyCode: '{{ currency.name }}',
            total: {
                label: '{{ oView.getApplePayLabel() }}',
                amount: {{ total.getPrice() }}
            },
            merchantCapabilities: [
                'supports3DS',
                {% for capability in oView.getSupportedApplePayMerchantCapabilities() %}
                    '{{ capability }}'{% if not loop.last %}, {% endif %}
                {% endfor %}
            ],
             supportedNetworks: [
                {% for network in oView.getSupportedApplePayNetworks() %}
                    '{{ network }}'{% if not loop.last %}, {% endif %}
                {% endfor %}
            ],
            requiredShippingContactFields: [],
            requiredBillingContactFields: [],
            lineItems: getApplePayLineItems(),
        };

        startApplePaySession(applePayPaymentRequest);
    }

    function getApplePayLineItems() {
        // --- Basket Data rendered via Twig ---
        const nettoSum = parseFloat("{{ oxcmp_basket.getNettoSum()|default('0') }}") || 0;
        const bruttoSum = parseFloat("{{ oxcmp_basket.getBruttoSum()|default('0') }}") || 0;
        const productVats = {{ oxcmp_basket.getProductVats(false)|json_encode|raw }};
        const discounts = {{ oxcmp_basket.getDiscounts()|json_encode|raw }};
        const isPriceViewNetto = {{ oxcmp_basket.isPriceViewModeNetto()|json_encode|raw }};
        const vouchers = {{ oxcmp_basket.getVouchers()|json_encode|raw }};
        const voucherDiscValue = parseFloat("{{ oxcmp_basket.getVoucherDiscValue()|default('0') }}") || 0;
        const basketUser = {{ oxcmp_basket.getBasketUser()|json_encode|raw }};
        const paymentCost = {{ oxcmp_basket.getPaymentCost()|json_encode|raw }};
        const wrappingCost = {{ oxcmp_basket.getWrappingCost()|json_encode|raw }};
        const basketWrappCostVat = {{ oxcmp_basket.getWrappCostVat()|json_encode|raw }};
        const giftCardCost = {{ oxcmp_basket.getGiftCardCost()|json_encode|raw }};
        const isProportionalCalculationOn = {{ oxcmp_basket.isProportionalCalculationOn()|json_encode|raw }};

        // Delivery cost – already set, or null.
        const deliveryCost = {{ deliveryCost ? deliveryCost|json_encode|raw : 'null' }};

        // --- View Configuration rendered as booleans ---
        const showVouchers = {{ viewConf.getShowVouchers()|json_encode|raw }};
        const showGiftWrapping = {{ viewConf.getShowGiftWrapping()|json_encode|raw }};
        const calcDelCostIfNotLoggedIn = {{ viewConf.isFunctionalityEnabled('blCalculateDelCostIfNotLoggedIn')|json_encode|raw }};
        const showVATForDelivery = {{ viewConf.isFunctionalityEnabled('blShowVATForDelivery')|json_encode|raw }};
        const showVATForPayCharge = {{ viewConf.isFunctionalityEnabled('blShowVATForPayCharge')|json_encode|raw }};
        const showVATForWrapping = {{ viewConf.isFunctionalityEnabled('blShowVATForWrapping')|json_encode|raw }};

        const lineItems = [];

        // --- Products / Discounts Section ---
        if (!discounts || discounts.length === 0) {
            // No discounts: add total net, each VAT, then total gross.
            lineItems.push({
                label: '{{ translate({ ident: "TOTAL_NET" }) }}',
                type: 'final',
                amount: nettoSum
            });
            for (const key in productVats) {
                if (productVats.hasOwnProperty(key)) {
                    lineItems.push({
                        // Replace the placeholder "KEY" with the actual VAT key.
                        label: '{{ translate({ ident: "VAT_PLUS_PERCENT_AMOUNT", args: "KEY" }) }}'.replace('KEY', key),
                        type: 'final',
                        amount: parseFloat(productVats[key]) || 0
                    });
                }
            }
            lineItems.push({
                label: '{{ translate({ ident: "TOTAL_GROSS" }) }}',
                type: 'final',
                amount: bruttoSum
            });
        } else {
            // With discounts.
            if (isPriceViewNetto) {
                lineItems.push({
                    label: '{{ translate({ ident: "TOTAL_NET" }) }}',
                    type: 'final',
                    amount: nettoSum
                });
            } else {
                lineItems.push({
                    label: '{{ translate({ ident: "TOTAL_GROSS" }) }}',
                    type: 'final',
                    amount: bruttoSum
                });
            }

            Object.entries(discounts).forEach(([key, discObj]) => {
                let discountFloat = -1 * (parseFloat(discObj.dDiscount));
                lineItems.push({
                    label: discObj.sDiscount,
                    type: 'final',
                    amount: discountFloat.toFixed(2)
                });
            });

            if (!isPriceViewNetto) {
                lineItems.push({
                    label: '{{ translate({ ident: "TOTAL_NET" }) }}',
                    type: 'final',
                    amount: nettoSum
                });
            }
            for (const key in productVats) {
                if (productVats.hasOwnProperty(key)) {
                    lineItems.push({
                        label: '{{ translate({ ident: "VAT_PLUS_PERCENT_AMOUNT", args: "KEY" }) }}'.replace('KEY', key),
                        type: 'final',
                        amount: parseFloat(productVats[key]) || 0
                    });
                }
            }

            if (isPriceViewNetto) {
                lineItems.push({
                    label: '{{ translate({ ident: "TOTAL_GROSS" }) }}',
                    type: 'final',
                    amount: bruttoSum
                });
            }
        }

        // --- Voucher Handling ---
        if (showVouchers && voucherDiscValue) {
            Object.values(vouchers).forEach(function(oVoucher) {
                let discountFloat = -1 * parseFloat(oVoucher.dVoucherdiscount);
                lineItems.push({
                    label: '{{ translate({ ident: "COUPON" }) }} ({{ translate({ ident: "NUMBER" }) }} ' + oVoucher.sVoucherNr + ')',
                    type: 'final',
                    amount: discountFloat.toFixed(2)
                });
            });
        }

        // --- Delivery Cost Handling ---
        if (deliveryCost && (basketUser || calcDelCostIfNotLoggedIn)) {
            if (showVATForDelivery) {
                const dShippingVatValue = parseFloat(deliveryCost.vatValue) || 0;
                lineItems.push({
                    label: '{{ translate({ ident: "SHIPPING_NET" }) }}',
                    type: 'final',
                    amount: parseFloat(deliveryCost.nettoPrice) || 0
                });
                if (dShippingVatValue) {
                    let shippingLabel = '';
                    if (isProportionalCalculationOn) {
                        shippingLabel = '{{ translate({ ident: "BASKET_TOTAL_PLUS_PROPORTIONAL_VAT", suffix: "COLON" }) }}';
                    } else {
                        shippingLabel = '{{ translate({ ident: "VAT_PLUS_PERCENT_AMOUNT", args: "VAT" }) }}'.replace('VAT', deliveryCost.vat);
                    }
                    lineItems.push({
                        label: shippingLabel,
                        type: 'final',
                        amount: dShippingVatValue
                    });
                }
            } else {
                lineItems.push({
                    label: '{{ translate({ ident: "SHIPPING_COST" }) }}',
                    type: 'final',
                    amount: parseFloat(deliveryCost.bruttoPrice) || 0
                });
            }
        }

        // --- Payment Cost Handling ---
        if (paymentCost && paymentCost.price) {
            if (showVATForPayCharge) {
                let label = '';
                if (paymentCost.price >= 0) {
                    label = '{{ translate({ ident: "SURCHARGE" }) }}';
                } else {
                    label = '{{ translate({ ident: "DEDUCTION" }) }}' + '{{ translate({ ident: "PAYMENT_METHOD" }) }}';
                }
                lineItems.push({
                    label: label,
                    type: 'final',
                    amount: parseFloat(paymentCost.nettoPrice) || 0
                });
            }
            if (paymentCost.vatValue) {
                let label = '';
                if (isProportionalCalculationOn) {
                    label = '{{ translate({ ident: "BASKET_TOTAL_PLUS_PROPORTIONAL_VAT" }) }}';
                } else {
                    label = '{{ translate({ ident: "SURCHARGE_PLUS_PERCENT_AMOUNT", args: "PAYVAT" }) }}'.replace('PAYVAT', paymentCost.vat);
                }
                lineItems.push({
                    label: label,
                    type: 'final',
                    amount: parseFloat(paymentCost.vatValue) || 0
                });
            }
        } else if (paymentCost) {
            let label = '';
            if (paymentCost.price >= 0) {
                label = '{{ translate({ ident: "SURCHARGE" }) }}';
            } else {
                label = '{{ translate({ ident: "DEDUCTION" }) }}' + '{{ translate({ ident: "PAYMENT_METHOD" }) }}';
            }
            lineItems.push({
                label: label,
                type: 'final',
                amount: parseFloat(paymentCost.bruttoPrice) || 0
            });
        }

        // --- Gift Wrapping and Gift Card Handling ---
        if (showGiftWrapping) {
            if (wrappingCost && wrappingCost.price > 0) {
                if (showVATForWrapping) {
                    lineItems.push({
                        label: '{{ translate({ ident: "BASKET_TOTAL_WRAPPING_COSTS_NET" }) }}',
                        type: 'final',
                        amount: parseFloat(wrappingCost.nettoPrice) || 0
                    });
                    if (basketWrappCostVat) {
                        lineItems.push({
                            label: '{{ translate({ ident: "PLUS_VAT" }) }}',
                            type: 'final',
                            amount: parseFloat(wrappingCost.vatValue) || 0
                        });
                    }
                } else {
                    lineItems.push({
                        label: '{{ translate({ ident: "GIFT_WRAPPING" }) }}',
                        type: 'final',
                        amount: parseFloat(wrappingCost.bruttoPrice) || 0
                    });
                }
            }
            if (giftCardCost && giftCardCost.price > 0) {
                if (showVATForWrapping) {
                    lineItems.push({
                        label: '{{ translate({ ident: "BASKET_TOTAL_GIFTCARD_COSTS_NET" }) }}',
                        type: 'final',
                        amount: parseFloat(giftCardCost.nettoPrice) || 0
                    });
                    let gcLabel = '';
                    if (isProportionalCalculationOn) {
                        gcLabel = '{{ translate({ ident: "BASKET_TOTAL_PLUS_PROPORTIONAL_VAT" }) }}';
                    } else {
                        gcLabel = '{{ translate({ ident: "VAT_PLUS_PERCENT_AMOUNT", args: "GCVAT" }) }}'.replace('GCVAT', giftCardCost.vat);
                    }
                    lineItems.push({
                        label: gcLabel,
                        type: 'final',
                        amount: parseFloat(giftCardCost.vatValue) || 0
                    });
                } else {
                    lineItems.push({
                        label: '{{ translate({ ident: "GREETING_CARD" }) }}',
                        type: 'final',
                        amount: parseFloat(giftCardCost.bruttoPrice) || 0
                    });
                }
            }
        }
        console.log("Apple Pay line items:");
        console.log(lineItems);
        return lineItems;
    }

    function handleError({ html = '{{ translate({ ident: "oscunzer_APPLEPAY_ERROR" }) }}', message, error } = {}) {
        console.error("Error occurred:", message, error);

        const errorElement = document.querySelector('.js-unzer-error-holder');
        if (errorElement) {
            errorElement.innerHTML = html;
            errorElement.style.display = 'block';
            errorElement.focus();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    }

    function abortPaymentSession(session) {
        console.warn("Aborting Apple Pay session...");
        session.completePayment({ status: window.ApplePaySession.STATUS_FAILURE });
        session.abort();
    }
    {% endcapture %}

    {% if false %}</script>{% endif %}

{{ script({ add: unzerApplePayJS, dynamic: __oxid_include_dynamic }) }}
